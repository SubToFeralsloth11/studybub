# StudyBub server environment variables.
# Copy this file to .env and generate secrets:
#   openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=
# Public application URL (used for notification click actions):
# In production this must be set to the absolute HTTPS origin (e.g. https://studybub.syntaxrewrite.com).
# In development/testing it defaults to http://localhost:3000 if unset.
STUDYBUB_PUBLIC_URL=http://localhost:3000
